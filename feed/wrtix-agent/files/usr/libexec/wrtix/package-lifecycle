#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
root=/etc/wrtix
agent=/usr/libexec/wrtix/agent
marker=$root/package-operation
commit=$root/package-commit
fail() { printf 'wrtix-agent: %s\n' "$1" >&2; exit 1; }
[ -d "$root" ] && [ ! -L "$root" ] || fail unsafe_state_directory
[ ! -L "$root/transaction.lock" ] || fail unsafe_lock
exec 9> "$root/transaction.lock"
flock -x 9
[ ! -L "$marker" ] || fail unsafe_package_marker
# Other coordinated lifecycle operations may fence configuration staging.
# Package hooks must not erase such a fence, even if no transaction is active.
if [ -e "$marker" ]; then
 [ -f "$marker" ] || fail unsafe_package_marker
 case "$(cat "$marker")" in commit|prepare-install|prepare-remove) :;; *) fail foreign_operation_pending;; esac
fi
idle() {
 local status
 status=$("$agent" status) || fail transaction_status_unavailable
 printf '%s' "$status" | jq -e '
  .state=="absent" or (.state=="confirmed" and .reload_complete==true) or
  (.state=="rolled-back")
 ' >/dev/null || fail transaction_pending
 [ ! -e "$root/transactions/state/restore-pending" ] &&
 [ ! -e "$root/transactions/state/rollback-reboot" ] &&
 [ ! -e "$root/transactions/state/rollback-incomplete" ] || fail restoration_pending
}
commit_alive() {
 [ -f "$commit" ] && [ ! -L "$commit" ] || return 1
 local pid ticks boot_id extra
 read -r pid ticks boot_id extra < "$commit" || return 1
 case "$pid:$ticks" in *[!0-9:]*|:*|*:) return 1;; esac
 [ -z "$extra" ] && [ "$boot_id" = "$(cat /proc/sys/kernel/random/boot_id)" ] &&
 [ -r "/proc/$pid/stat" ] && [ "$(awk '{print $22}' "/proc/$pid/stat")" = "$ticks" ]
}
case "${1:-}" in
 prepare-commit)
  idle
  [ ! -L "$commit" ] || fail unsafe_commit_marker
  commit_alive && fail package_commit_already_running
  apk_pid=$(awk '{print $4}' "/proc/$$/stat")
  apk_ticks=$(awk '{print $22}' "/proc/$apk_pid/stat")
  printf '%s %s %s\n' "$apk_pid" "$apk_ticks" "$(cat /proc/sys/kernel/random/boot_id)" > "$commit.new.$$"
  mv "$commit.new.$$" "$commit"
  printf 'commit\n' > "$marker.new.$$"
  mv "$marker.new.$$" "$marker"
  ;;
 prepare-install|prepare-remove)
  idle
  printf '%s\n' "$1" > "$marker.new.$$"
  chmod 600 "$marker.new.$$"
  mv "$marker.new.$$" "$marker"
  flock -u 9
  # The persistent marker blocks staging after releasing the package lock.
  # No transaction is active. Stop only this package's own watcher, retaining
  # every user's network, service and authentication setting.
  /etc/init.d/wrtix-agent stop >/dev/null 2>&1 || fail guard_stop_failed
  if [ "$1" = prepare-remove ]; then
   /etc/init.d/wrtix-agent disable >/dev/null 2>&1 || fail guard_disable_failed
  fi
  ;;
 finish-install|finish-commit)
  [ -f "$marker" ] || fail missing_package_marker
  # Verify the exact package-owned runtime set before permitting deployments.
  [ -f /usr/share/wrtix/runtime.sha256 ] && [ ! -L /usr/share/wrtix/runtime.sha256 ] || fail missing_runtime_inventory
  awk 'NF!=2 || length($1)!=64 || $1 !~ /^[0-9a-f]+$/ {exit 1}
   $2=="usr/libexec/wrtix/agent" {a++;next}
   $2=="etc/init.d/wrtix-agent" {b++;next}
   $2=="usr/share/wrtix/contract.json" {c++;next}
   {exit 1} END {if(a!=1 || b!=1 || c!=1) exit 1}' /usr/share/wrtix/runtime.sha256 || fail invalid_runtime_inventory
  (cd /; sha256sum -c /usr/share/wrtix/runtime.sha256 >/dev/null) || fail runtime_hash_mismatch
  cp -p "$marker" "$marker.saved.$$"
  trap '[ ! -f "$marker.saved.$$" ] || mv "$marker.saved.$$" "$marker"' EXIT HUP INT TERM
  rm "$marker"
  if ! "$agent" identity | jq -e '.profile=="wrtix-v2" and (.contract_sha256|type=="string" and length==64)' >/dev/null; then
   mv "$marker.saved.$$" "$marker"
   fail runtime_identity_failed
  fi
  idle
  /etc/init.d/wrtix-agent enable >/dev/null 2>&1 || fail guard_enable_failed
  if [ "$1" = finish-install ] && command -v apk >/dev/null 2>&1; then
   mv "$marker.saved.$$" "$marker"
  else
   rm "$marker.saved.$$"
   rm -f "$commit"
  fi
  trap - EXIT HUP INT TERM
  ;;
 *) fail invalid_package_action;;
esac
