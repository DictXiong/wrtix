#!/bin/sh /etc/rc.common
START=03
STOP=99
USE_PROCD=1
# OpenWrt's package removal wrapper stops init scripts before the package's
# own prerm hook. Reject that stop here while restoration protection is needed.
# rc.common replaces stop() for procd services, so this check runs while the
# script is sourced, before rc.common dispatches the requested action.
case "${action:-}" in
 stop|disable|restart)
  if [ -z "${IPKG_INSTROOT:-}" ] && [ -d /etc/wrtix ]; then
   [ ! -L /etc/wrtix/transaction.lock ] || exit 1
   exec 9> /etc/wrtix/transaction.lock
   flock -x 9 || exit 1
   guard_state=/etc/wrtix/transactions/state
   guard_status=$(/usr/libexec/wrtix/agent status) || exit 1
   printf '%s' "$guard_status" | jq -e '.state=="absent" or (.state=="confirmed" and .reload_complete==true) or .state=="rolled-back"' >/dev/null || exit 1
   [ ! -e "$guard_state/restore-pending" ] && [ ! -e "$guard_state/rollback-reboot" ] &&
    [ ! -e "$guard_state/rollback-incomplete" ] || exit 1
  fi
  ;;
esac
restart() {
 stop "$@" || return 1
 flock -u 9 || return 1
 start "$@"
}
start_service() {
 local tool=/usr/libexec/wrtix/agent token
 local state=/etc/wrtix/transactions/state
 [ -f "$tool" ] && [ ! -L "$tool" ] || return 1
 /bin/sh "$tool" early || return 1
 [ -f "$state/manifest.json" ] || return 0
 if [ ! -f "$state/restore-pending" ] && [ ! -e "$state/rollback-reboot" ]; then
  [ ! -f "$state/confirmed" ] && [ ! -f "$state/rolled-back" ] || return 0
 fi
 token=$(jq -er '.token | select(type == "string" and length == 32)' "$state/manifest.json") || return 1
 case "$token" in *[!0-9a-f]*) return 1;; esac
 # Distinguish a new transaction from an exited instance with the same command.
 procd_open_instance rollback
 procd_set_param command /bin/sh "$tool" watch "$token"
 procd_set_param respawn 3600 2 10
 procd_set_param term_timeout 5
 procd_set_param stdout 0
 procd_set_param stderr 1
 procd_close_instance
}
